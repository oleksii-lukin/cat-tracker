{
  "expo": {
    "name": "cat-tracker",
    "slug": "cat-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cattracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F3E7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.llamerr.cattracker"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "locales": {
      "ru": "./languages/ru.json",
      "uk": "./languages/uk.json",
      "be": "./languages/be.json",
      "en": "./languages/en.json",
      "es": "./languages/es.json",
      "de": "./languages/de.json",
      "it": "./languages/it.json",
      "fr": "./languages/fr.json"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложение использует фото, чтобы прикреплять снимки стула и других наблюдений к событиям."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["ru", "uk", "be", "en", "es", "de", "it", "fr"],
            "android": ["ru", "uk", "be", "en", "es", "de", "it", "fr"]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8F3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "501eb007-74df-41bf-86a2-156742036b84"
      }
    }
  }
}
